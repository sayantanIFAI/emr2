# CDI-Adapter env for the RunPod pod (native services on localhost).
CDI_ENV=runpod
CDI_LOG_LEVEL=INFO
CDI_LOG_JSON=false

CDI_DATABASE_URL=postgresql+psycopg://cdi:cdi@127.0.0.1:5432/cdi
CDI_REDIS_URL=redis://127.0.0.1:6379/0

CDI_S3_ENDPOINT_URL=http://127.0.0.1:9000
# the next two and the database password are replaced on a deployed pod by generated secrets
# (deploy_fresh_pod.sh appends them to .env); the app refuses to start with these defaults when CDI_ENV is not dev
CDI_S3_ACCESS_KEY=cdiadmin
CDI_S3_SECRET_KEY=cdiadminsecret
CDI_S3_BUCKET=cdi-documents
CDI_S3_REGION=us-east-1

CDI_INBOX_DIR=/workspace/data/inbox
CDI_PROCESSED_DIR=/workspace/data/processed
CDI_FAILED_DIR=/workspace/data/failed
CDI_PAGE_DPI=200

# web app - bind the one RunPod-proxied HTTP port on this pod (8888, was jupyter).
# Live URL:  https://<RUNPOD_POD_ID>-8888.proxy.runpod.net
CDI_WEBAPP_PORT=8888

# model gateway (cdi_adapter.mlserve) - transformers Qwen2.5-VL, bf16
CDI_MLSERVE_URL=http://127.0.0.1:8077
CDI_MLSERVE_PORT=8077
# vLLM (its own venv, started by start_all.sh) is ~3x faster to read a prescription than transformers: it
# decodes ~85 tokens/s on an RTX 6000 Ada with fp8 weights and batches the handwriting lines. Rollback:
# CDI_MLSERVE_BACKEND=hf (and CDI_QWEN_LINE_CONCURRENCY=1, CDI_EXTRACT_CONCURRENCY=1).
CDI_MLSERVE_BACKEND=vllm
CDI_VLLM_QUANT=fp8
CDI_VLLM_GPU_UTIL=0.80
CDI_VLLM_MAX_SEQS=16
CDI_QWEN_LINE_CONCURRENCY=12
# No grammar-constrained JSON on vLLM: with these schemas (extra keys allowed) it made the model invent its
# own layout and drop fields. The schema is in the prompt and the repair/retry path checks the answer, as on
# the transformers server. Measured on two real photos: constrained = empty / misfiled, free = complete.
CDI_VLLM_GUIDED=false
CDI_VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
CDI_VLM_FALLBACK_MODEL_ID=Qwen/Qwen2-VL-7B-Instruct
# the fallback is as large as the primary: it loads in 8-bit (bitsandbytes) and every fact it
# reads is held for review until it is benchmarked on real handwriting (docs/fallback-model.md)
CDI_VLM_FALLBACK_QUANTIZE=8bit
CDI_GATE_FALLBACK_REVIEW=true
CDI_VLM_DTYPE=bfloat16

CDI_OCR_ENGINE=rapidocr
CDI_HANDWRITTEN_USES_VLM=true

CDI_LLM_BASE_URL=http://127.0.0.1:8000/v1
CDI_DSLM_MODEL=cdi-dslm

CDI_IG_PACKAGE=nrces.fhir.r4.ndhm#6.5.0

# --- deployment surface: one admin uploads images; no review screens, no FHIR until the owner asks ---
CDI_REVIEW_UI_ENABLED=false
CDI_FHIR_ENABLED=false
CDI_START_FHIR=0
CDI_START_DISPATCH=0
CDI_ADMIN_USER=admin
# no ABDM / ABHA identification: never asked for, read, validated or used (like FHIR and the review screens)
CDI_ABHA_ENABLED=false
# medicine names (built from the A-Z medicines dataset, kept OUT of git): a medicine is never shown as a lab test
CDI_MEDICINE_LEXICON_PATH=/workspace/data/medicine_names.txt
# the Indian national code sets (Common Lab Codes for India + Common Drug Codes for India), built on the pod, kept OUT of git
CDI_INDIAN_CODES_DIR=/workspace/data
CDI_LICENSED_CODE_SYSTEMS='["LOINC","UCUM","CDCI"]'
# CDI_ADMIN_PASSWORD is generated on the pod by deploy_fresh_pod.sh (never committed)

# --- reader: Qwen2.5-VL-7B (GPU) reads every handwriting line; RapidOCR (CPU) reads the printed text ---
CDI_RECOGNITION_V2=true
CDI_RAPIDOCR_USE_CUDA=false
CDI_OCRHOST_URL=http://127.0.0.1:8079
CDI_OCRHOST_PORT=8079
