# Copy to .env for local dev. Compose sets its own values.
CDI_ENV=dev
CDI_LOG_LEVEL=INFO
CDI_LOG_JSON=false

CDI_DATABASE_URL=postgresql+psycopg://cdi:cdi@localhost:5432/cdi
CDI_REDIS_URL=redis://localhost:6379/0

CDI_S3_ENDPOINT_URL=http://localhost:9000
CDI_S3_ACCESS_KEY=cdiadmin
CDI_S3_SECRET_KEY=cdiadminsecret
CDI_S3_BUCKET=cdi-documents
CDI_S3_REGION=us-east-1

CDI_INBOX_DIR=./data/inbox
CDI_PROCESSED_DIR=./data/processed
CDI_FAILED_DIR=./data/failed
CDI_PAGE_DPI=200

# model gateway (vLLM, OpenAI-compatible) - used from Phase 1 remainder onward
CDI_LLM_BASE_URL=http://localhost:8000/v1
CDI_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
CDI_DSLM_MODEL=cdi-dslm

CDI_IG_PACKAGE=nrces.fhir.r4.ndhm#6.5.0

# ---- recognition v2 (ARCHITECTURE §15) ----
CDI_RECOGNITION_V2=true
# CPU OCR host (RapidOCR). Blank = run RapidOCR inside each worker process.
CDI_OCRHOST_URL=http://127.0.0.1:8079
CDI_OCRHOST_PORT=8079
CDI_QWEN_LINE_MODE=crop
CDI_ENGINE_AGREE_SIMILARITY=0.85
# advisory Qwen tie-break on disagreements (orders readings; never auto-accepts)
CDI_QWEN_ADJUDICATION_ENABLED=false
# image quality gate: enforce = hold for rescan | warn | off
CDI_QUALITY_GATE_MODE=enforce
CDI_GROUNDING_ENABLED=true
CDI_GATE_POLICY_ENABLED=true
# CDI_GATE_POLICY_PATH=/workspace/cdi/policy.json
CDI_PRACTITIONER_MIN_LINK_CONF=0.90

# ---- file listener: local | onedrive | sharepoint | gdrive | pkg.module:Class  (docs/LISTENER.md) ----
CDI_LISTENER_CONNECTOR=local
CDI_LISTENER_ROOT=./data/listener        # local: a folder | onedrive/gdrive: folder path in the drive (e.g. OCR)
CDI_LISTENER_INBOX=inbox                 # "." = drop prescriptions straight into the root folder
CDI_LISTENER_COMPLETED=success
CDI_LISTENER_ERROR=error
CDI_LISTENER_LOG=log                     # failure-reason notes only
CDI_LISTENER_POLL_SECONDS=10
CDI_LISTENER_BATCH_SIZE=3                # files processed together as one batch
CDI_LISTENER_BATCH_WAIT_SECONDS=60       # release a short batch after this long (0 = never wait)
CDI_LISTENER_STABLE_POLLS=2
CDI_LISTENER_MAX_ATTEMPTS=3              # retries after the first failure (DB-enforced cap)
CDI_LISTENER_RETRY_BASE_SECONDS=60       # retry delay = base * 2^n
CDI_LISTENER_PIPELINE=inline
# Microsoft Graph (onedrive / sharepoint)
CDI_GRAPH_AUTH=app                       # app (admin consent) | device_code (sign in once: --login)
CDI_GRAPH_TENANT_ID=
CDI_GRAPH_CLIENT_ID=
CDI_GRAPH_CLIENT_SECRET=
CDI_GRAPH_CERT_PATH=
CDI_GRAPH_CERT_THUMBPRINT=
CDI_GRAPH_TOKEN_CACHE=./data/graph_token_cache.json   # device_code: keep on a persistent disk
CDI_GRAPH_DRIVE_ID=
CDI_GRAPH_USER_ID=
CDI_GRAPH_SITE_ID=
# Google Drive (gdrive)
CDI_GDRIVE_AUTH=service_account          # service_account | oauth
CDI_GDRIVE_CREDENTIALS_FILE=
CDI_GDRIVE_IMPERSONATE_USER=
CDI_GDRIVE_CLIENT_ID=
CDI_GDRIVE_CLIENT_SECRET=
CDI_GDRIVE_REFRESH_TOKEN=
CDI_GDRIVE_ROOT_FOLDER_ID=
CDI_GDRIVE_DRIVE_ID=

# ---- agents ----
CDI_FHIR_AGENT_POLL_SECONDS=5
CDI_DISPATCH_POLL_SECONDS=30
